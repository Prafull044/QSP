class ProdOfBuzzNum 
{
	public static void main(String[] args) 
	{
		int [] arr = {49,7,14,8,9,10};
		System.out.println("Product of bzz num is "+ ProdOfBuzz(arr));
	}
	
	public static int ProdOfBuzz(int [] num)
	{
		int prod = 1;
		for (int i = 0;i<num.length ;i++ )
		{
			if (num[i] % 7 == 0 ||  num[i] % 10 == 7)
			{
				prod =prod * num[i];
			}
		}
		return prod;
	}
}
