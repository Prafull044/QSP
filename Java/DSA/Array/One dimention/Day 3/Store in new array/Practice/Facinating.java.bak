class Facinating
{
	public static void main(String[] args) 
	{
		int [] arr = {12,33,193,55,145,153,8,3,25,4, 2025};
		check(arr);
	}
	
	public static void check(int [] arr)
	{
		for (int i = 0;i<arr.length ;i++ )
		{
		    if(isFaci(arr[i]))
		    {
		    	System.out.println(arr[i]);
		    }
		}
	}
	
	public static boolean isFaci(int num)
	{
		if (num > 99 && num < 1000)
		{
			int sum = num * 1000000 + num * 2000 + num * 3;
			
			for (int i = 1;i<= 9 ;i++ )
			{
				int count = 0;
				int temp = sum;
				while (sum != 0)
				{
					int digit = sum % 10;
					if (digit == i)
					{
						count++;
					}
					sum /= 10;
				}
				
				if (count != 1)
				{
					return false;
				}
				
				sum = temp;
			}
		   return true;
		}
		return false;
	}
}
