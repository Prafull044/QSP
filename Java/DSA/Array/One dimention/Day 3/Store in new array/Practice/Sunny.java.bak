class  Sunny 
{
	public static void main(String[] args) 
	{
		int [] arr = {12,33,44,55,145,153,8,33,908};
		check(arr);
	}
	
	public static void check(int [] arr)
	{
		for (int i = 0;i<arr.length ;i++ )
		{
		    if(isSunny(arr[i]))
		    {
		    	System.out.println(arr[i]);
		    }
		}
	}
	
	public static boolean isSunny(int num)
	{
		int n = num+1;
		for (int i = 1;i<= n/2 ;i++ )
		{
			if (i* i == n)
			{
				return true;
			}
		}
		
		return false;
	}
	
	
}
