class HarshadNum1 {
    static int count = 0;

    public static void main(String[] args) {
        int[] arr = {12, 34, 55, 33, 31, 59, 39, 29, 18};

		int[]  harshad = storeHarshadNum(arr);
		
		for (int i = 0;i<count ;i++ )
		{
			System.out.println(harshad[i]);
		}
        System.out.println("Count: " + count);
		
    }
	
	public static int[] storeHarshadNum(int[] nums)
	{
		int [] harshad = new int[count];
		int index =0;
		
		for (int i = 0;i<nums.length ;i++ )
		{
			if (isHarshadNum(nums[i]))
			{
				harshad [index] = nums[i];
				index++;
				count++;
			}
		}
		return harshad;
	}
	

    public static boolean isHarshadNum(int num) {
        int n = num;
        int sum = 0;

        while (num != 0) {
            sum = sum + num % 10;
            num = num / 10;
        }

        return n % sum == 0;
    }
}