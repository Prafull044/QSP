// 8.print characters in reverse order from char[]
class  ReverseArray
{
	public static void main(String[] args) 
	{
		char[] ch = {'A', '7', '@', 'b', '#', '9', '$', '3', 'M'};
		reverseArray(ch);
	}
	
	public static void reverseArray(char ch[])
	{
		for (int i = (ch.length-1); i>= 0 ;i-- )
		{
			System.out.print(ch[i] + " ");
		}
	}
}

