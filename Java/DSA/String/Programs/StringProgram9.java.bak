// WAP to count only Lowercase character in a given String
class StringProgram9
{
	public static void main(String[] args) 
	{
		String str = "PrafULL";
		int count = 0;
		
		for(int i = 0 ; i<str.length() ; i++)
		{
			if(str.charAt(i) >= 'a' && str.charAt(i) <= 'b')
			{
				count++;
 			}
		}
		System.out.println(count);
	}
}