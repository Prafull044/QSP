import java.util.Scanner;
class TwinPrime
{
	public static void main(String[] args) 
	{
	   Scanner sc  = new Scanner(System.in);
	   System.out.println("Enter a number");
	   int num = sc.nextInt();
	   
	   System.out.println("Enter a number");
	   int num2 = sc.nextInt();
	   
	   if (num <= 1  || num2 <= 1)
	   {
		   System.out.println("Not TwinPrime Number");
		   return;
	   }
	   
	   boolean isPrime = true;
	   
	   if (num - num2  = -2 || num -num2 = 2)
	   {
		   for (int i = 2; i<=num/2 ; i++)
		   {
			   if (num % i == 0 )
			   {
				   isPrime = false;
				   break;
			   }
		   }
		   
		     for (int i = 2; i<=num2/2 ; i++)
		   {
			   if (num % i == 0 )
			   {
				   isPrime = false;
				   break;
			   }
		   }
		   
		   if (isPrime)
		   {
			   System.out.println("TwinPrime Number");
		   }
		   else
			{
			   System.out.println("Not TwinPrime Number");
		    }
		   
	   }
	   else
		{
			System.out.println("Not a TwinPrime Number");
		}
	   
	   
	   
	
	}
}
