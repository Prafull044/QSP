class reverse
{
	public static void main(String[] args) 
	{
		int num =112356;
		int last= num % 10;
		num /=10;
		System.out.print(last);
		int last2= num % 10;
		num /=10;
		System.out.print(last2);
		 
		    int rev = 0;
			while (num != 0)
			{
				rev = rev * 10 + (num % 10);
				num /= 10;
			}
			
			while (rev != 0)
			{
				System.out.print(rev % 10);
				rev/= 10;
			}
		}
}