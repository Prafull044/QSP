class FascinatingNum 
{
	public static void main(String[] args) 
	{
		System.out.println(isFascinating(192));
	}
	
	public static boolean isFascinating(int num)
	{
		int res = (num * 1000000 ) + (num*2 * 1000) + (num * 3);
		
		for (int i = 1;i<= 9 ;i++ )
		{
			int ct  = 0;
			for (int j = res; j != 0;j/= 10)
			{
				int last = j % 10;
				if (last == i)
				{
					ct++;
				}
			}
			if (ct == 0)
			{
				return false;
			}
		}
		return true;
	}
}
