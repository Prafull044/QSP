
class NumberProgramDriver
{
    public static void main(String[] args)
    {
        NumberProgramsImp num1 = new NumberProgramsImp();

        // Area of Circle
        num1.areaOfCircle(5);

        // Perimeter of Circle
        num1.perimeterOfCircle(5);
		
        System.out.println("Prime: " + NumberPrograms.isPrime(7));

        // Armstrong Number
        System.out.println("Armstrong: " + num1.isArmstrong(153));

        // Square Pattern
        num1.squarePattern(4);

        // Twisted Prime
        System.out.println("Twisted Prime: " + num1.twistedPrime(13));

        // Palindrome
        System.out.println("Palindrome: " + num1.isPalindrome(121));

        // Static method: reverse()
        System.out.println("Reverse: " + NumberPrograms.reverse(123));

    }
}


