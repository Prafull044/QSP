class Factorial
{
	public static void main(String[] args) 
	{
		int num =5 ;
		System.out.println(factorial(num, 1, 1));
	}
	
	public static int factorial(int num , int ct ,int value )
	{
		if(ct > num)
		{
	       return value;
		}
		
	    value = value  * ct;
	    return factorial(num, ct + 1,value );
		
		
       // if(num == 0)
       //     return 1;
        
       // return num * factorial(num - 1); 
	}
}
