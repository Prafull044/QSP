class Num60 
{
	public static void main(String[] args) 
	{
		int n = 4;
		
		int b= (n*2)-1;
		int c = 1;
		
		for (int i = 1;i<=n ;i++ )
		{
			int a = i;
			for (int j = 1;j<= n ;j++ )
			{
				System.out.print(a +" ");
				if (a<10)
				{
					System.out.print(" ");
				}
			   a= (j%2 != 0)?( a+b): (a+c);
			}
			b = b-2;
			a = a+ 2;
			System.out.println();
		}
	
	}
}
