  // 4  8  12 16
  // 20 24 28 32
  // 36 40 44 48
  // 52 56 60 64
  // 
class P31
{
	public static void main(String[] args) 
	{
		int n = 4;
		int num = n;
		for (int i =1 ;i<= n ;i++ )
		{
			for (int j = 1;j<=n ;j++ )
			{
				System.out.print(num +" ");
				if (num<9)
				{
					System.out.print(" ");
				}
				num = num+ n;
				
			}
			System.out.println();
		}
	}
}
