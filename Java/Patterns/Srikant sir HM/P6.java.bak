class P6
{
	public static void main(String[] args) 
	{
		int n = 7;
		int b = 2;
		for (int i=1;i<= n ;i++ )
		{
			for (int j =1;j<=n ;j++)
			{
				if (j>=n-b+1 || j<= b ||i==1|| i==n|| i+j == n+1 )
				{
					System.out.print("*"+" ");
				}
				else
				{
					System.out.print(" "+" ");
				}
			}
			System.out.println();
		}
	}
}