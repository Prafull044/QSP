// 12)WAP to print avg of odd elements

 class  SumOfOddIndexAvg
{
	public static void main(String[] args) 
	{
		int [] arr = {12, 15, 18, 21, 24, 27};
		System.out.println("Avg of odd index elements "+ sumOfOdd(arr));
    }
	
	public static int sumOfOdd(int num[] )
	{   
		int sum = 0;
		int count = 0;
		for (int i = 0;i< num.length ;i++ )
		{
			if (i % 2 != 0)
			{
				sum += num[i];
				count++;
			}
		}
		return sum / count;
	}
	
}