// 17.WAP to print first 3 character from char[]

// 18.WAP to print last 3 character from char[]
class PrintALpha3char
{
	public static void main(String[] args) 
	{
		char[] ch = {'A', 'b', '@', 'E', 'm', '#', 'u', 'P', '7'};
		
		for (int i  ;i<3 ;i++ )
		{
				System.out.print(ch[i] +" ");
		}
	}
}