class producOfEvenEle
{
	public static void main(String[] args) 
	{
		int [] arr = {10, 20, 30, 40, 50};
		System.out.println("product of even elements"+ prodOfEvenEle(arr));
	}
	
	public static int prodOfEvenEle(int num[])
	{
		int prod = 1;
		
		for (int i =0;i<num.length ; i++ )
		{
			if (i % 2 == 0)
			{
				prod *= num[i];
			}
		}
		return prod;
	}
}
