class Reverse
{
    public static void main(String[] args)
    {
        for (int num = 200; num <= 500; num++)
        {
            int temp = num;
            int r = 0;

            while (temp > 0)
            {
                int last = temp % 10;
                r = r * 10 + last;
                temp /= 10;
            }

            System.out.println(r);
        }
    }
}